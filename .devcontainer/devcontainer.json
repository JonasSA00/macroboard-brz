{
  "name": "Macroboard BRZ - ESP32-S2",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "platformio.platformio-ide",
        "ms-vscode.cpptools",
        "xaver.clang-format",
        "mhutchie.git-graph"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.compilerPath": "",
        "platformio-ide.useBuiltinPIOCore": false,
        "platformio-ide.customPATH": "/usr/local/bin:/usr/bin:/bin",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "xaver.clang-format"
      }
    }
  },
  "mounts": [
    "type=volume,source=platformio-home,target=/root/.platformio",
    "type=volume,source=ssh-home,target=/root/.ssh",
    "type=bind,source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "runArgs": [
    "--privileged",
    "-v", "/dev:/dev"
  ],
  "postCreateCommand": "mkdir -p /root/.ssh && chmod 700 /root/.ssh && (test -f /root/.ssh/config || printf '%s\n' 'Host github.com' '  HostName github.com' '  User git' '  IdentityFile /root/.ssh/id_ed25519_macroboard_brz' '  IdentitiesOnly yes' '  StrictHostKeyChecking accept-new' > /root/.ssh/config) && chmod 600 /root/.ssh/config && platformio pkg install",
  "remoteUser": "root"
}
