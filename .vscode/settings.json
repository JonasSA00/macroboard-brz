{
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "xaver.clang-format",
    "clang-format.executable": "/usr/bin/clang-format",
    "files.associations": {
        "*.h": "cpp",
        "*.cpp": "cpp"
    },
    "C_Cpp.intelliSenseEngine": "default",
    "platformio-ide.customPATH": "/usr/local/bin:/usr/bin:/bin",
    "[cpp]": {
        "editor.defaultFormatter": "xaver.clang-format"
    }
}
